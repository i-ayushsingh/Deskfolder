{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskFolder",
  "version": "0.1.0",
  "identifier": "com.deskfolder.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DeskFolder",
        "width": 520,
        "height": 600,
        "minWidth": 420,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "url": "index.html?mode=dashboard"
      },
      {
        "label": "overlay",
        "title": "DeskFolder Overlay",
        "width": 360,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "index.html?mode=overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost https://tauri.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "DeskFolder",
    "category": "Utility",
    "shortDescription": "Mobile-style app folders for the Windows desktop.",
    "longDescription": "DeskFolder brings the fluid, mobile-style 'App Folder' experience to the Windows desktop. Group apps into a sleek floating popup instead of a full File Explorer window.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
